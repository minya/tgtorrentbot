#!/bin/bash
# Pin the sibling minya modules to their latest commits, wherever a go.mod
# requires them: logger and goutils into rutracker (and telegram, should it
# require them again), then logger, goutils, rutracker and telegram into
# tgtorrentbot. A module a go.mod does not require is skipped.
# A module is pinned only at a commit that is clean and pushed, since the
# Go proxy can only fetch what is on the remote. The script stops at the
# first failure.
set -euo pipefail

# require_published <module_src_path>: fail unless the source tree is
# clean and its HEAD is on a remote branch.
require_published() {
    local src="$1"
    if [ -n "$(git -C "$src" status --porcelain)" ]; then
        echo "$(basename "$src") has uncommitted changes; commit and push them first." >&2
        return 1
    fi
    if [ -z "$(git -C "$src" branch -r --contains HEAD 2>/dev/null)" ]; then
        echo "$(basename "$src") HEAD $(git -C "$src" rev-parse --short=12 HEAD) is not pushed; push it first." >&2
        return 1
    fi
}

# update_module <target_mod_path> <module_name> <module_src_path>
update_module() {
    local target_mod_path="$1"
    local module_name="$2"
    local module_src_path="$3"
    local target
    target="$(basename "$target_mod_path")"

    echo "Checking $module_name module in $target..."

    local version
    version=$(grep -E "github\.com/minya/$module_name v[0-9]" "$target_mod_path/go.mod" | grep -v '=>' | awk '{print $2}' || true)
    local mod_commit
    mod_commit=$(echo "$version" | cut -d '-' -f 3)
    if [ -z "$mod_commit" ]; then
        echo "Failed to extract the commit from the $module_name version in $target/go.mod" >&2
        return 1
    fi

    local latest_commit
    latest_commit=$(git -C "$module_src_path" rev-parse --short=12 HEAD)

    if [ "$mod_commit" == "$latest_commit" ]; then
        echo "$module_name is up to date in $target (commit: $mod_commit)"
        echo ""
        return 0
    fi

    require_published "$module_src_path"
    echo "Updating $module_name in $target: $mod_commit -> $latest_commit"
    # No -u: pin this module only, without upgrading every dependency it has.
    (
        cd "$target_mod_path"
        go get "github.com/minya/$module_name@$latest_commit"
        go mod tidy
    )
    echo "$module_name updated in $target"
    echo ""
}

cd "$(dirname "$0")"
scriptdir="$(pwd)"
libs="$scriptdir/.."

# requires <target_mod_path> <module_name>: whether the target's go.mod
# requires the module (directly or as // indirect).
requires() {
    grep -Eq "github\.com/minya/$2 v[0-9]" "$1/go.mod"
}

# pin <target_mod_path> <module>...: pin each module the target requires.
pin() {
    local target="$1"; shift
    local m
    for m in "$@"; do
        if requires "$target" "$m"; then
            update_module "$target" "$m" "$libs/$m"
        fi
    done
}

# 1. Libraries that depend on other minya libraries. Today only rutracker
#    does (goutils, logger); telegram, logger and goutils have none.
for lib in rutracker telegram; do
    pin "$libs/$lib" logger goutils
    # A bumped library only reaches tgtorrentbot once that bump is a pushed
    # commit, so stop here until it is.
    if [ -n "$(git -C "$libs/$lib" status --porcelain -- go.mod go.sum)" ]; then
        echo "$lib's go.mod changed. Commit and push $lib, then run this script again." >&2
        exit 1
    fi
done

# 2. tgtorrentbot itself.
pin "$scriptdir" logger goutils rutracker telegram

echo "Dependency updates complete!"
