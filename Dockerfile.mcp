FROM golang:1.25-alpine AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/tgtorrentbot-mcp ./cmd/tgtorrentbot-mcp

FROM alpine:3.20

RUN apk add --no-cache ca-certificates libc6-compat && \
    addgroup -S -g 1000 appgroup && adduser -S -u 1000 -G appgroup appuser

WORKDIR /app
COPY --from=build /out/tgtorrentbot-mcp ./tgtorrentbot-mcp

USER appuser

EXPOSE 8080

CMD ["/app/tgtorrentbot-mcp"]
