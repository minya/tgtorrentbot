FROM golang:1.25-alpine AS build

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/tgtorrentbot ./cmd/tgtorrentbot

FROM alpine:3.22

# uid/gid 1000, as in Dockerfile.mcp: the auto-fixer rewrites tags and
# renames folders in the mounted downloads, so it must own them like the
# MCP server does.
RUN apk add --no-cache ca-certificates && \
    addgroup -S -g 1000 appgroup && adduser -S -u 1000 -G appgroup appuser

WORKDIR /app
COPY --from=build /out/tgtorrentbot ./tgtorrentbot

USER appuser

EXPOSE 80

CMD ["/app/tgtorrentbot"]
